{
  "name": "pixelmist",
  "private": true,
  "version": "0.0.0",
  "description": "Pixelmist design system \u2014 Mistral-inspired, cross-platform (web / desktop / mobile), React + TypeScript",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/mobile",
    "apps/desktop"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@pixelmist/web",
    "tokens": "npm run build -w @pixelmist/tokens",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck:mobile": "npm run build && npm --prefix apps/mobile install --no-audit --no-fund && npm --prefix apps/mobile run typecheck",
    "forge:generate": "/home/mateim/.config/aseprite/extensions/RetroDiffusion/stable-diffusion-aseprite/venv/bin/python pixel-forge/scripts/rd_pipeline.py && /home/mateim/.config/aseprite/extensions/RetroDiffusion/stable-diffusion-aseprite/venv/bin/python pixel-forge/scripts/build_showcase.py",
    "forge:showcase": "/home/mateim/.config/aseprite/extensions/RetroDiffusion/stable-diffusion-aseprite/venv/bin/python pixel-forge/scripts/build_showcase.py",
    "changeset": "changeset"
  },
  "devDependencies": {
    "electron-to-chromium": "1.5.477",
    "turbo": "^2.3.0",
    "typescript": "~5.6.3",
    "@changesets/cli": "^3.0.3",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2"
  },
  "packageManager": "npm@12.2.0"
}
