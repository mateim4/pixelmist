{
  "name": "pixelmist",
  "private": true,
  "version": "0.0.0",
  "description": "Pixelmist design system — Mistral-inspired, cross-platform (web / desktop / mobile), React + TypeScript",
  "workspaces": ["packages/*", "apps/web"],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@pixelmist/web",
    "tokens": "npm run build -w @pixelmist/tokens"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "~5.6.3"
  },
  "packageManager": "npm@12.2.0"
}
