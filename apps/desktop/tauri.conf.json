{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixelmist",
  "version": "0.1.0",
  "identifier": "ai.pixelmist.app",
  "build": {
    "beforeDevCommand": "npm run dev -w @pixelmist/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @pixelmist/web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixelmist",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "src-tauri/icons/32x32.png",
      "src-tauri/icons/128x128.png",
      "src-tauri/icons/128x128@2x.png",
      "src-tauri/icons/icon.png"
    ]
  }
}
