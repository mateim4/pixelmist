{
  "name": "@pixelmist/core",
  "version": "0.1.0",
  "description": "Platform-agnostic core: utilities, hooks and types shared by @pixelmist/react and @pixelmist/native. No DOM, no react-native imports.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "restricted"
  }
}
