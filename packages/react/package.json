{
  "name": "@pixelmist/react",
  "version": "0.1.0",
  "description": "Pixelmist components for the DOM (web + desktop via Tauri). Styled with CSS custom properties emitted by @pixelmist/tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,react-dom && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@pixelmist/core": "^0.1.0",
    "@pixelmist/icons": "^0.1.0",
    "@pixelmist/tokens": "^0.1.0"
  },
  "devDependencies": {
    "@pixelmist/core": "^0.1.0",
    "@pixelmist/icons": "^0.1.0",
    "@pixelmist/tokens": "^0.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.6.3",
    "vitest": "^5.1.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
